{
  "name": "@cinebook/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:backend": "npm run dev",
    "dev:frontend": "npm --prefix ../frontend run dev",
    "build": "tsc",
    "build:frontend": "npm --prefix ../frontend run build",
    "build:all": "npm run build && npm --prefix ../frontend run build",
    "start": "node dist/src/index.js",
    "worker": "tsx watch src/workers/ticketWorker.ts",
    "worker:start": "node dist/src/workers/ticketWorker.js",
    "worker:health": "node scripts/worker-health.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "prisma db seed",
    "test": "vitest run",
    "lint:frontend": "npm --prefix ../frontend run lint",
    "test:all": "npm run test && npm --prefix ../frontend run lint",
    "smoke": "node scripts/smoke.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "openai": "^4.76.3",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
